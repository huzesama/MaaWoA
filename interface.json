{
    "interface_version": 2,
    "icon": "resource/base/logo.png",
    "name": "maawoa",
    "label": "MaaWoA",
    "version": "v0.0.4",
    "description": "$pi.description",
    "contact": "$pi.contact",
    "license": "[GNU Affero General Public License v3.0 (AGPL-3.0)](https://github.com/huzesama/MaaWoA/blob/main/LICENSE)",
    "welcome": "$pi.welcome",
    "github": "https://github.com/huzesama/MaaWoA",
    "languages": {
        "zh_cn": "resource/base/languages/zh_cn.json",
        "zh_tw": "resource/base/languages/zh_tw.json",
        "en_us": "resource/base/languages/en_us.json"
    },
    "controller": [
        {
            "name": "Adb",
            "label": "Android / Emulator",
            "type": "Adb",
            "display_expand": [1280, 720]
        },
        {
            "name": "Windows",
            "label": "Windows app",
            "type": "Win32",
            "display_expand": [1280, 720],
            "permission_required": true,
            "win32": {
                "mouse": "Seize",
                "keyboard": "Seize",
                "screencap": "FramePool"
            },
            "attach_resource_path": [
                "./resource/desktop"
            ]
        },
        {
            "name": "MacOS",
            "label": "MacOS App",
            "type": "MacOS",
            "display_expand": [1280, 720],
            "permission_required": true,
            "macos": {
                "input": "GlobalEvent",
                "screencap": "ScreenCaptureKit"
            },
            "attach_resource_path": [
                "./resource/desktop"
            ]
        },
        {
            "name": "PlayCover",
            "label": "PlayCover iOS app",
            "type": "PlayCover",
            "display_expand": [1280, 720],
            "attach_resource_path": [
                "./resource/desktop"
            ]
        },
        {
            "name": "Gamepad",
            "label": "Gamepad (Windows)",
            "type": "Gamepad",
            "display_expand": [1280, 720]
        },
        {
            "name": "Linux",
            "label": "wlroots app (Linux)",
            "type": "Linux",
            "display_expand": [1280, 720]
        }
    ],
    "resource": [
        {
            "name": "base",
            "label": "$pi.resource.label.base.name",
            "path": [
                "./resource/base"
            ]
        }
    ],
    "import": [
        "./tasks/base.json",
        "./resource/base/option/dailyUnique.json",
        "./resource/base/option/base.json",
        "./resource/base/option/onnx.json"
    ],
    "agent": [
        {
            "child_exec": "uv",
            "child_args": [
                "run",
                "python",
                "agent/main.py"
            ]
        }
    ]
}
