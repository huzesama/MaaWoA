		{
			"name": "dailyUniqueArrival",
			"label": "$pi.task.dailyUniqueArrival.name",
			"entry": "unattendedMode",
			"default_check": true,
			"description": "this is description",
			"desc": [
				"this is desc"
			],
			"option": [
				"acceptDailyUniqueContractsType"
			]
		},
		{
			"name": "unattendedMode",
			"label": "$pi.task.unattendedMode.name",
			"entry": "unattendedMode",
			"default_check": true,
			"description": "this is description",
			"desc": [
				"this is desc"
			],
			"option": [
				"entryAirportIATA"
			]
		},
		{
			"name": "test",
			"entry": "test"
		}
	],
	"option": {
		"acceptDailyUniqueContractsType": { //每日特殊入港的处理方式
			"label": "$pi.task.option.acceptDailyUniqueContractsType.name",
			"description": "",
			"type": "select",
			"default_case": "acceptOnly",
			"cases": [
				{
					"name": "acceptOnly",
					"label": "$pi.task.option.acceptDailyUniqueContractsType.acceptOnly.name",
					"pipeline_override": {
						"detectAirportSelectPage": { //更改只从列表选择
							"next": [
								"detectAitportList",
								"finishNode"
							]
						},
						"detectAitportList": {
							"next": [
								"[JumpBack]resetAirportList", //该节点不含next
								"dailyUniqueContract.detectUniqueAirport",
								"dailyUniqueContract.selectUniqueAirport",
								"dailyUniqueContract.detectAitportListEnd",
								"finishNode"
							]
						},
						"detectAirport_info": { //检测机场信息面板不再OCR IATA而是直接进入
							"next": [
								"entryAirport",
								"finishNode"
							]
						},
						"detectEntryAirportPage": { //从筛选器准备改为点击合同管理
							"next": [
								"dailyUniqueContract.detectDockerContractNotice",
								"dailyUniqueContract.detectEntryAirportPage",
								"finishNode"
							]
						}
					}
				},
				{
					"name": "threshold",
					"label": "$pi.task.option.acceptDailyUniqueContractsType.threshold.name",
					"option": [
						//"dailyTaskTower",
						"dailyUniqueContractsHandleThreshold"
					],
					"pipeline_override": {
						"detectAirportSelectPage": { //更改只从列表选择
							"next": [
								"detectAitportList",
								"finishNode"
							]
						},
						"detectAitportList": {
							"next": [
								"[JumpBack]resetAirportList", //该节点不含next
								"dailyUniqueContract.detectUniqueAirport",
								"dailyUniqueContract.selectUniqueAirport",
								"dailyUniqueContract.detectAitportListEnd",
								"finishNode"
							]
						},
						"detectAirport_info": { //检测机场信息面板不再OCR IATA而是直接进入
							"next": [
								"entryAirport",
								"finishNode"
							]
						},
						"dailyUniqueContract.exitContractPage": { //退出合同管理页后回退至父节点检测当前页面
							"next": "finishNode"
						},
						"detectEntryAirportPage": { //从筛选器准备改为点击合同管理，检测特殊入港合同数量阈值
							"next": [
								"dailyUniqueContract.detectDockerContractNotice",
								"[JumpBack]detectFilter",
								"[JumpBack]dailyUniqueContract.entryHandleUnique",
								"dailyUniqueContract.detectEntryAirportPage",
								"finishNode"
							]
						},
						"filterReady": { //更改了next的顺序，并将loop action替换为continue Handle Unique
							"next": [
								"[JumpBack]detectFilter",
								"[JumpBack]detectFilterArrivalButton",
								"[JumpBack]detectFilterAirplaneOnAirportButton",
								"[JumpBack]detectFilterDepartureButton",
								"[JumpBack]detectFilterActionRequiringButton",
								"[JumpBack]detectFilterUniqueButton",
								"[JumpBack]detectFilterFavoriteButton",
								"[JumpBack]dailyUniqueContract.continueHandleUnique",
								"finishNode" //跳回dailyUniqueContract.entryHandleUnique节点
							]
						},
						"detectFilterUniqueButton": { //更改为筛选特殊入港航班
							"recognition": {
								"type": "Custom",
								"param": {
									"custom_recognition": "onnxDetect",
									"custom_recognition_param": {
										"expected": [
											"filterUnique"
										]
									}
								}
							}
						}
					}
				}
			]
		},
		"dailyTaskTower": { //每日特殊入港任务的是否开启塔台选项
			"type": "switch",
			"default_case": "No",
			"cases": [
				{
					"name": "Yes"
				},
				{
					"name": "No"
				}
			]
		},
		"dailyUniqueContractsHandleThreshold": { //每日特殊入港处理方式阈值选项下的输入
			"type": "input",
			"inputs": [
				{
					"name": "dailyUniqueContractsUpper",
					"label": "",
					"description": "",
					"default": "60",
					"pipeline_type": "int",
					"verify": "^\\d+$"
				},
				{
					"name": "dailyUniqueContractsLower",
					"label": "",
					"description": "",
					"default": "10",
					"pipeline_type": "int",
					"verify": "^\\d+$"
				}
			],
			"pipeline_override": {
				"dailyUniqueContract.entryHandleUnique": { //主要更改阈值
					"recognition": {
						"type": "And",
						"param": {
							"all_of": [
								"dailyUniqueContract.detectFilterUniqueBox",
								{
									"recognition": {
										"type": "Custom",
										"param": {
											"custom_recognition": "dailyUniqueCompare",
											"custom_recognition_param": {
												"threshold": "{dailyUniqueContractsUpper}"
											}
										}
									}
								}
							]
						}
					},
					"next": [
						"filterReady",
						"finishNode"
					]
				},
				"dailyUniqueContract.continueHandleUnique": { //主要更改阈值
					"recognition": {
						"type": "Custom",
						"param": {
							"custom_recognition": "dailyUniqueCompare",
							"custom_recognition_param": {
								"threshold": "{dailyUniqueContractsLower}"
							}
						}
					},
					"next": [
						"compareCrewUsed",
						"[JumpBack]actionRequiringSelectDeparture",
						"finishNode"
					]
				}
			} //通过custom传参Int类型{dailyUniqueContractsUpper}{dailyUniqueContractsLower}
		},
