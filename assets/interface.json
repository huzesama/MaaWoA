{
	"interface_version": 2,
	"languages": {
		"zh_hans": "Languages/zh_hans.json",
		"zh_hant": "Languages/zh_hant.json",
		"en_us": "Languages/en_us.json"
	},
	"icon": "resource/logo.png",
	"name": "MaaWoA",
	"label": "$pi.label",
	//"title": "",//窗口标题，Client 会直接显示该内容，不添加其他修饰。可选，默认使用 name 和 version 拼接生成。
	"description": "$pi.description",
	"contact": "$pi.contact",
	"license": "[GNU Affero General Public License v3.0 (AGPL-3.0)](https://github.com/huzesama/MaaWoA/blob/main/LICENSE)",
	"welcome": "$pi.welcome",
	// 填写项目地址和版本号可实现自动更新功能
	"github": "https://github.com/huzesama/MaaWoA",
	"version": "v0.0.2_beta_202509121",
	// Mirror酱为第三方分发服务，新项目默认关闭
	// 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
	// "mirrorchyan_rid": "MaaXXX",
	// "mirrorchyan_multiplatform": true,
	"controller": [
		{
			"name": "ADB",
			"label": "ADB", // 显示名称，支持国际化。优先显示label，未设置时显示name
			"description": "$pi.control.adb.description", // 控制器详细描述。支持文件路径、URL或直接文本，内容支持Markdown格式，支持国际化
			//"icon": "adb.png", // 控制器图标文件路径，相对于项目根目录
			"type": "Adb",
			"display_short_side": 720, // 默认缩放分辨率的短边长度，用于屏幕适配。与long_side二选一
			"permission_required": false
		},
		{
			"name": "Win32",
			"label": "Win32",
			"description": "$pi.control.Win32.description", // 控制器详细描述。支持文件路径、URL或直接文本，内容支持Markdown格式，支持国际化
			//"icon": "adb.png", // 控制器图标文件路径，相对于项目根目录
			"type": "Win32",
			"display_short_side": 720, // 默认缩放分辨率的短边长度，用于屏幕适配。与long_side二选一
			"permission_required": true,
			"win32": {
				"mouse": "Seize",
				"keyboard": "Seize",
				"screencap": "FramePool"
			},
			"attach_resource_path": [
				"./resource_desktop"
			]
		},
		{
			"name": "MacOS",
			"label": "MacOS",
			"description": "$pi.control.MacOS.description", // 控制器详细描述。支持文件路径、URL或直接文本，内容支持Markdown格式，支持国际化
			//"icon": "adb.png", // 控制器图标文件路径，相对于项目根目录
			"type": "MacOS",
			"display_short_side": 720, // 默认缩放分辨率的短边长度，用于屏幕适配。与long_side二选一
			"permission_required": true,
			"macos": {
				"input": "PostToPid",
				"screencap": "ScreenCaptureKit"
			},
			"attach_resource_path": [
				"./resource_desktop"
			]
		},
		{
			"name": "Linux",
			"label": "Linux",
			"description": "pi.control.Linux.description", // 控制器详细描述。支持文件路径、URL或直接文本，内容支持Markdown格式，支持国际化
			//"icon": "adb.png", // 控制器图标文件路径，相对于项目根目录
			"type": "WlRoots",
			"display_short_side": 720, // 默认缩放分辨率的短边长度，用于屏幕适配。与long_side二选一
			"permission_required": true,
			"attach_resource_path": [
				"./resource_desktop"
			]
		}
	],
	"resource": [
		{
			"name": "universal",
			"label": "$pi.resource.label.universal",
			"path": [
				"./resource"
			]
		}
	],
	// 可选的 agent 示例
	// "agent": {
	//     "child_exec": "python",
	//     "child_args": [
	//         "./agent/main.py"
	//     ]
	// },
	"task": [
		{ //日常特殊入港
			"name": "dailyUniqueArrival",
			"label": "$pi.task.dailyUniqueArrival.name",
			"entry": "unattendedMode",
			"default_check": true,
			"description": "$pi.task.dailyUniqueArrival.description",
			"option": [
				//"enableTower",
				"notSkipProcessUp",
				"unknownPageWaitting",
				"randomSelectStand",
				"ONNX",
				"acceptDailyUniqueContractsType",
				"bribery"
			],
			"pipeline_override": {
				"detectAirportSelectPage": { //更改只从列表选择
					"next": [
						"detectAitportList",
						"finishNode"
					]
				},
				"detectAitportList": { //只更改选择方式
					"next": [
						"[JumpBack]resetAirportList", //该节点不含next
						"dailyUniqueContract.detectUniqueAirport",
						"dailyUniqueContract.selectUniqueAirport",
						"dailyUniqueContract.detectAitportListEnd",
						"finishNode"
					]
				},
				"detectAirport_info": { //检测机场信息面板不再OCR IATA而是直接进入
					"next": [
						"entryAirport",
						"finishNode"
					]
				}
			}
		},
		{ //挂机
			"name": "unattendedMode",
			"label": "$pi.task.unattendedMode.name",
			"entry": "unattendedMode",
			"default_check": true,
			"description": "$pi.task.unattendedMode.description",
			"option": [
				//"enableTower",
				"notSkipProcessUp",
				"unknownPageWaitting",
				"randomSelectStand",
				"ONNX",
				"entryAirportIATA",
				"bribery"
			]
		},
		{ //功能测试
			"name": "test",
			"label": "$pi.task.test.name",
			"description": "$pi.task.test.description",
			"entry": "test"
		}
	],
	"option": {
		"freezeCheck": {
			"controller": [
				"ADB"
			],
			"label": "$pi.task.option.freezeCheck.name",
			"description": "$pi.task.option.freezeCheck.description",
			"type": "switch",
			"default_case": "No",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"isFreezeOrNot": {
							"enabled": true
						}
					}
				},
				{
					"name": "No",
					"pipeline_override": {
						"isFreezeOrNot": {
							"enabled": false
						}
					}
				}
			]
		}
	},
	"agent": [
		{
			"child_exec": "python",
			"child_args": [
				"./agent/main.py"
			]
		}
	],
	"import": [
		"./resource/option/dailyUnique.json",
		"./resource/option/base.json",
		"./resource/option/onnx.json"
	]
}