		"freezeCheck": {
			"controller": [
				"ADB"
			],
			"label": "$pi.task.option.freezeCheck.name",
			"description": "$pi.task.option.freezeCheck.description",
			"type": "switch",
			"default_case": "No",
			"cases": [
