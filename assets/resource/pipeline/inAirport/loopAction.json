{
	"filterReady": { //过滤器筛选的准备
		"next": [
			"[JumpBack]startLoopAction",
			"[JumpBack]detectFilter",
			"[JumpBack]detectFilterArrivalButton",
			"[JumpBack]detectFilterAirplaneOnAirportButton",
			"[JumpBack]detectFilterDepartureButton",
			"[JumpBack]detectFilterActionRequiringButton",
			"[JumpBack]detectFilterUniqueButton",
			"[JumpBack]detectFilterFavoriteButton",
			"finishNode" //跳回detectPage节点
		]
	},
	"startLoopAction": { //开始行动请求的处理循环
		"next": [
			"compareCrewUsed",
			"[JumpBack]actionRequiringSelectDeparture",
			"finishNode"
		]
	},
	"detectFilter": { //默认打开过滤器
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-widget.onnx",
				"threshold": 0.708,
				"expected": 10
			}
		},
		"action": "Click",
		"focus": {
			"Node.Node.Action.Starting": "$pipeline.loopAction.detectFilter.focus.action.Starting"
		}
	},
	"detectFilterActionRequiringButton": { //默认筛选行动事件
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-widget.onnx",
				"threshold": 0.708,
				"expected": 20
			}
		},
		"action": "Click",
		"focus": {
			"Node.Node.Action.Starting": "$pipeline.loopAction.detectFilterActionRequiringButton.focus.action.Starting"
		}
	},
	"detectFilterArrivalButton": { //默认取消过滤到达航班
