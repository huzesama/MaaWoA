{
	"compareCrewUsed": { //对比crew used，不相等时未命中
		"recognition": {
			"type": "And",
			"param": {
				"all_of": [
					"detectCrewUsed",
					{
						"recognition": {
							"type": "Custom",
							"param": {
								"custom_recognition": "crewUsedCompare"
							}
						}
					}
				]
			}
		},
		"next": [
			"actionRequiringSelect",
			"finishNode"
		]
	},
	"detectCrewUsed": { //检测crew used的box
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-widget.onnx",
				"threshold": 0.708,
				"expected": 8
			}
		}
	},
	"crewUsedOCR": { //通过检测crew used的定位进行OCR,在crewUsedCompare.py中引用
		"recognition": {
			"type": "OCR",
			"param": {
				"only_rec": true,
				"roi": "detectCrewUsed"
			}
		}
	}
}