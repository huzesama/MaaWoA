{
	"dailyUniqueContract.detectDockerContractNotice": { //检测合同管理图标
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-widget.onnx",
				//"threshold": 0.708,
				"expected": 41
			}
		},
		"target_offset": [
			10,
			10,
			-20,
			-20
		],
		"action": "Click",
		"next": [
			"dailyUniqueContract.detectContractPage"
		],
		"focus": {
			"Node.Recognition.Succeeded": "$pipeline.dailyUniqueContract.detectDockerContractNotice.focus.recognition.Succeeded"
		}
	},
	"dailyUniqueContract.detectContractPage": { //检测合同管理页
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-page.onnx",
				//"threshold": 0.893,
				"expected": 7
			}
		},
		"next": [
			"[JumpBack]dailyUniqueContract.detectUniqueContractOffers",
			"dailyUniqueContract.exitContractPage"
		]
	},
	"dailyUniqueContract.detectUniqueContractOffers": { //检测特殊入港合同卡片
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-card.onnx",
				//"threshold": 0.633,
				"expected": 19
			}
		},
		"next": [
			"dailyUniqueContract.acceptDailyUniqueContract",
			"dailyUniqueContract.detectContractAcceptConfirmCard"
		],
		"focus": {
			"Node.Recognition.Succeeded": "$pipeline.dailyUniqueContract.detectUniqueContractOffers.focus.recognition.Succeeded"
		}
	},
	"dailyUniqueContract.acceptDailyUniqueContract": { //点击接受合同
		"recognition": {
			//"type": "NeuralNetworkDetect",//神经网络检测识别目标的box 是在反算完 x、y、w、h 并加上 roi_.x/roi_.y 偏移后直接构造出来的，没有与 roi_ 求交集，待修复
			"type": "ColorMatch",
			"param": {
				"method": 40,
				"lower": [
					13,
					244,
					222
				],
				"upper": [
					35,
					255,
					244
				],
				"count": 3000,
				"order_by": "Area",
				"connected": true,
				//"model": "WoA-widget.onnx",
				////"threshold": 0.708,
				//"expected": 4,
				"roi": "dailyUniqueContract.detectUniqueContractOffers"
			}
		},
		"action": "Click",
		"post_delay": 500,
		"next": [
			"dailyUniqueContract.detectContractAcceptConfirmCard",
			"finishNode"
		],
		"focus": {
			"Node.Action.Starting": "$pipeline.dailyUniqueContract.acceptDailyUniqueContract.focus.action.Starting"
		}
	},
	"dailyUniqueContract.detectContractAcceptConfirmCard": { //检测合同确认卡片的box
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-card.onnx",
				//"threshold": 0.633,
				"expected": 17
			}
		},
		"next": [
			"dailyUniqueContract.acceptDailyUniqueContractConfirm"
		]
	},
	"dailyUniqueContract.acceptDailyUniqueContractConfirm": { //点击确认
		"recognition": {
			//"type": "NeuralNetworkDetect",//神经网络检测识别目标的box 是在反算完 x、y、w、h 并加上 roi_.x/roi_.y 偏移后直接构造出来的，没有与 roi_ 求交集，待修复
			"type": "ColorMatch",
			"param": {
				"method": 40,
				"lower": [
					13,
					244,
					222
				],
				"upper": [
					35,
					255,
					244
				],
				"count": 3000,
				"order_by": "Area",
				"connected": true,
				//"model": "WoA-widget.onnx",
				////"threshold": 0.708,
				//"expected": 4,
				"roi": "dailyUniqueContract.detectContractAcceptConfirmCard"
			}
		},
		"action": "Click",
		"next": [
			"[JumpBack]detectLoadingPage",
			"finishNode"
		]
	},
	"dailyUniqueContract.exitContractPage": { //退出合同管理
		"recognition": {
			"type": "ColorMatch",
			"param": {
				"method": 40,
				"lower": [
					94,
					145,
					51
				],
				"upper": [
					116,
					167,
					73
				],
				"connected": true,
				"order_by": "Horizontal",
				"count": 1000
			}
		},
		"action": "Click",
		"next": [
			"dailyUniqueContract.detectEntryAirportPage"
		],
		"focus": {
			"Node.Action.Starting": "$pipeline.dailyUniqueContract.exitContractPage.focus.action.Starting"
		}
	},
	"dailyUniqueContract.detectEntryAirportPage": { //检测entry airport page
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-page.onnx",
				//"threshold": 0.893,
				"expected": 5
			}
		},
		"next": [
			"dailyUniqueContract.detectMenuButton"
		],
		"focus": {
			"Node.Recognition.Succeeded": "$pipeline.dailyUniqueContract.detectEntryAirportPage.focus.recognition.Succeeded"
		}
	},
	"dailyUniqueContract.detectMenuButton": { //检测菜单按钮并点击//recognition由ONNX选项覆写
		"recognition": {
			"type": "Or",
			"param": {
				"any_of": [
					{
						"recognition": {
							"type": "ColorMatch",
							"param": {
								"method": 40,
								"lower": [
									94,
									145,
									51
								],
								"upper": [
									116,
									167,
									73
								],
								"count": 1500,
								"order_by": "Vertical",
								"connected": true
							}
						}
					},
					{
						"recognition": {
							"type": "NeuralNetworkDetect",
							"param": {
								"model": "WoA-widget.onnx",
								//"threshold": 0.708,
								"expected": 7
							}
						}
					}
				]
			}
		},
		"action": "Click",
		"target_offset": [
			10,
			10,
			-20,
			-20
		],
		"post_delay": 500,
		"next": [
			"dailyUniqueContract.detectMenu",
			"finishNode"
		]
	},
	"dailyUniqueContract.detectMenu": { //检测菜单界面
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-card.onnx",
				//"threshold": 0.633,
				"expected": 13
			}
		},
		"next": [
			"dailyUniqueContract.exitEntryAirportPage"
		]
	},
	"dailyUniqueContract.exitEntryAirportPage": { //更换机场，后续如果出现进入图鉴的情况需要优化训练，并增加通过roi_offset进行target检查
		"recognition": {
			//"type": "NeuralNetworkDetect",//神经网络检测识别目标的box 是在反算完 x、y、w、h 并加上 roi_.x/roi_.y 偏移后直接构造出来的，没有与 roi_ 求交集，待修复
			"type": "ColorMatch",
			"param": {
				"method": 40,
				"lower": [
					13,
					244,
					222
				],
				"upper": [
					35,
					255,
					244
				],
				"count": 5000,
				"order_by": "Vertical",
				"connected": true,
				"roi": "dailyUniqueContract.detectMenu"
			}
		},
		"post_delay": 500,
		"action": "Click"
	}
}