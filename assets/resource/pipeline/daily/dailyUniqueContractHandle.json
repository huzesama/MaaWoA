{
	"dailyUniqueContract.selectUniqueAirport": { //检测特殊入港的机场
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-card.onnx",
				"threshold": 0.633,
				"expected": 2
			}
		},
		"post_wait_freezes": 500,
		"action": "Click",
		"target_offset": [
			10,
			10,
			-10,
			-10
		],
		"next": [
			"detectAirport_info",
			"finishNode"
		],
		"focus": {
			"Node.Recognition.Succeeded": "$pipeline.dailyUniqueContract.selectUniqueAirport.focus.reconigtion.Succeeded"
		}
	},
	"dailyUniqueContract.detectUniqueAirport": { //在选择列表中检测特殊入港机场
		"recognition": {
			"type": "Or",
			"param": {
				"any_of": [
					{
						"recognition": {
							"type": "NeuralNetworkDetect",
							"param": {
								"model": "WoA-card.onnx",
								"threshold": 0.633,
								"expected": 2
							}
						}
					},
					"dailyUniqueContract.detectAitportListEnd"
				]
			}
		},
		"inverse": true,
		"action": "Custom",
		"custom_action": "swipe_inBoxByVector",
		"custom_action_param": {
			"node_name": "detectAitportList",
			"vector": [
				0,
				"-20%"
			],
			"duration": 300,
			"random_start": true
		},
		"post_wait_freezes": {
			"time": 500,
			"target": "detectAitportList",
			"target_offset": [
				0,
				10,
				0,
				0
			]
		},
		"next": [
			"dailyUniqueContract.detectUniqueAirport",
			"dailyUniqueContract.selectUniqueAirport",
			"dailyUniqueContract.detectAitportListEnd"
		]
	},
	"dailyUniqueContract.detectAitportListEnd": { //当滑动机场选择列表出现最后一个机场的IATA时结束此任务（当前版本最后一个IATA为CNN）
		"recognition": {
			"type": "OCR",
			"param": {
				"expected": [
					"CNN"
				],
				"roi": "detectAitportList",
				"roi_offset": [
					0,
					5,
					0,
					0
				]
			}
		},
		"action": "StopTask",
		"focus": {
			"Node.Recognition.Succeeded": "$pipeline.dailyUniqueContract.detectAitportListEnd.focus.reconigtion.Succeeded"
		}
	},
	"dailyUniqueContract.detectFilterUniqueBox": { //检测过滤器的特殊入港筛选按钮位置
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-widget.onnx",
				"threshold": 0.708,
				"expected": [
					21,
					22
				]
			}
		}
	},
	"dailyUniqueContract.checkRemainingUniqueContrtactsQuantity": { //OCR特殊入港的字符串，由dailyUniqueCompare.py引用
		"recognition": {
			"type": "OCR",
			"param": {
				"expected": [
					"^\\d+/\\d+$"
				],
				"replace": [
					[
						"\\|",
						"/"
					]
				],
				"roi": "dailyUniqueContract.detectFilterUniqueBox"
			}
		}
	},
	"dailyUniqueContract.entryHandleUnique": { //判断是否进入特殊入港处理的节点
		"recognition": {
			"type": "And",
			"param": {
				"all_of": [
					"dailyUniqueContract.detectFilterUniqueBox",
					{
						"recognition": {
							"type": "Custom",
							"param": {
								"custom_recognition": "dailyUniqueCompare",
								"custom_recognition_param": {
									"threshold": 60 //通过interface option 阈值覆写
								}
							}
						}
					}
				]
			}
		},
		"next": [
			"filterReady",
			"finishNode"
		],
		"focus": {
			"Node.Recognition.Succeeded": "$pipeline.dailyUniqueContract.entryHandleUnique.focus.reconigtion.Succeeded"
		}
	},
	"dailyUniqueContract.continueHandleUnique": { //判断是否继续特殊入港处理的节点//filterUniquePressed需要强化学习
		"recognition": {
			"type": "Custom",
			"param": {
				"custom_recognition": "dailyUniqueCompare",
				"custom_recognition_param": {
					"threshold": 10 //通过interface option 阈值覆写
				}
			}
		},
		"next": [
			"compareCrewUsed",
			"[JumpBack]actionRequiringSelectDeparture",
			"finishNode"
		]
	}
}