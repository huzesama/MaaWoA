			"type": "Or",
			"param": {
				"any_of": [
					{
						"recognition": {
							"type": "TemplateMatch",
							"param": {
								"method": 10001,
								"threshold": 0.9,
								"template": [
									"离场航班.png"
								]
							}
						}
					},
					{
						"recognition": {
							"type": "NeuralNetworkDetect",
