{
	"compareCrewUsed": { //对比crew used，不相等时未命中
		"recognition": {
			"type": "And",
			"param": {
				"all_of": [
					{
						"recognition": {
							"type": "Custom",
							"param": {
								"custom_recognition": "crewUsedCompare",
								"custom_recognition_param": {
									"update_cache": false
								}
							}
						}
					},
					"actionRequiringSelect"
				],
				"box_index": 1
			}
		},
		"action": "Click",
		"next": [
			"detectFlight_info",
			"finishNode"
		]
	},
	"cacheCrewUsedBox": { //缓存地勤用量的box
		"recognition": {
			"type": "And",
			"param": {
				"all_of": [
					{
						"sub_name": "CrewUsedButton",
						"recognition": {
							"type": "NeuralNetworkDetect",
							"param": {
								"model": "WoA-widget.onnx",
								//"threshold": 0.708,
								"expected": 8
							}
						}
					},
					{
						"recognition": {
							"type": "ColorMatch",
							"param": {
								"method": 40,
								"lower": [
									94,
									145,
									51
								],
								"upper": [
									116,
									167,
									73
								],
								"connected": true,
								"order_by": "Area",
								"index": -1,
								"roi": "CrewUsedButton"
							}
						}
					}
				],
				"box_index": 1
			}
		},
		"max_hit": 1
	},
	"crewUsedOCR": { //通过检测crew used的定位进行OCR,在crewUsedCompare.py中引用
		"recognition": {
			"type": "OCR",
			"param": {
				"only_rec": true,
				"roi": "cacheCrewUsedBox",
				"color_filter": "textBinarization"
			}
		}
	},
	"updateCrewUsed": { //使用and类型更新缓存记录
		"recognition": {
			"type": "Custom",
			"param": {
				"custom_recognition": "crewUsedCompare",
				"custom_recognition_param": {
					"update_cache": true
				}
			}
		}
	}
}