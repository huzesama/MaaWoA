{
	"compareCrewUsed": { //对比crew used
		"recognition": {
			"type": "Custom",
			"param": {
				"custom_recognition": "crewUsedCompare"
			}
		}
	},
	"detectCrewUsed": { //检测crew used的box
		"recognition": {
			"type": "Custom",
