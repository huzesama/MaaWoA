			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA_202608092_imgsz256.onnx"
			}
		}
	},
	"MyDetectNode": { //查看神经网络检测(IoU)在当前页面可以检测到的元素
		"recognition": "Custom",
		"custom_recognition": "onnxDetect",
		"custom_recognition_param": {
			//"expected":11
		}
	},
	"swipeAirportCard": {
		"recognition": "Custom",
		"custom_recognition": "onnxDetect",
		"custom_recognition_param": {
			//"expected":11
		},
		"action": "Click"
	},
	"MySwipeNode": {
		"action": "Custom",
		"custom_action": "SwipeByVector",
