		"focus": "一样"
	},
	"NodeB": {
		"recognition": "DirectHit",
		"action": "DoNothing",
		"focus": "不一样"
	},
	"detectCurrentPageParam": { //查看神经网络检测(IoM)在当前页面可以检测到的元素
