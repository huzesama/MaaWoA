{
    "startApp": {
        "action": "DoNothing",
        "anchor": {
            "afterStop": "finishNode"
        },
        "next": [
            "[Anchor]afterStart"
        ],
        "focus": "$desktop.pipeline.restartApp.focus"
    },
    "stopApp": {
        "action": "DoNothing",
        "next": [
            "[Anchor]afterStop"
        ],
        "focus": null
    },
    "restartApp": {
        "anchor": {
            "afterStop": "startApp"
        },
        "next": [
            "stopApp"
        ],
        "focus": null
    }
}
