{
    "startApp": {
        "action": "DoNothing",
        "anchor": {
            "afterStop": "finishNode"
        },
        "next": [
            "[Anchor]afterStart"
        ],
        "focus": {
            "Node.Action.Starting": {
                "content": "$desktop.pipeline.restartApp.focus",
                "display": [
                    "log",
                    "toast"
                ]
            }
        }
    },
    "stopApp": {
        "action": "DoNothing",
        "next": [
            "[Anchor]afterStop"
        ],
        "focus": null
    },
    "restartApp": {
        "anchor": {
            "afterStop": "startApp"
        },
        "next": [
            "stopApp"
        ],
        "focus": null
    }
}
