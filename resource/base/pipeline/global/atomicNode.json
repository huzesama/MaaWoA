{
    //存放内置原始识别类型的识别节点
    //引用类型的节点，命名以双下划线"__"开头并同样以"__"结尾
    //命名规则: __识别种类[cmatch|tmatch|detect|ocr|classify|...]目标__
    "__cacheCrewUsedBox__": {
        //缓存地勤用量的box
        "max_hit": 1, //没有使用roi缓存管理，设置max_hit限制最大执行次数
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "crewUsed",
                "model": "WoA-widget.onnx"
            }
        }
    },
    "__cacheFlight_infoCard__": {
        //缓存航班详细信息卡片
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "roiManager",
                "custom_recognition_param": {
                    "roi_name": "__cacheFlight_infoCard__",
                    "model": "WoA-card.onnx",
                    "expected": "flight_info",
                    "threshold": 0.85
                }
            }
        }
    },
