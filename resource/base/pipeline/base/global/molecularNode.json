{
    //存放复合识别类型的节点，例如复合Match实现与原子节点中单个神经网络模型节点相似的效果
    //引用类型的节点，命名以双下划线"__"开头并同样以"__"结尾
    //命名规则: __组合原子节点的功能名称__
    //
    //------------------MATCH·BEGIN------------------
    "__conditionLoading__": {
        //识别错误率较高的机场页加载
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cmatchLoadingPageMenu__",
                    "__cmatchLoadingPageCircle__"
                ]
            }
        }
    },
    "__findActionRequire__": {
        //只用ONNX缓存
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cstmatchActionRequireList__",
                    "__tmatchActionRequireByLowThr__"
                ]
            }
        }
    },
    //------------------MATCH·END------------------
    "__conditionAssignCrewPass__": {
        //前置ROI：__cstGetFlight_infoCard__、__cstGetAssignCrewCard__
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__tmatchFlight_infoTimeLimitPass",
                    "__tmatchAssignCrewCardPlusButtonBeGray__"
                ]
            }
        }
    },
    "__conditionStandSelectOptionExist__": {
        //前置ROI：__cstGetStandSelectCard__
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__cmatchStandSelectPlannerOption__",
                    "__cmtachStandSelectOption__"
                ]
            }
        }
    },
    "__updateActionAssignCrew__": {
        //更新分配地勤卡片的ROI缓存
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cstUpdateAssignCrewCard__",
                    "__cstUpdateAssignCrewCardRampAgentSwitch__"
                ]
            }
        }
    },
    "__findFlight_infoActionRequireWithCache__": {
        //通过缓存寻找航班详情的请求事件
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cstGetFlight_infoCard__",
                    "__cmatchFlight_infoTitleWithCache__",
                    "__cmatchFlight_infoActionRequireInTitleWithCache__"
                ]
            }
        }
    },
    "__findFlight_infoActionRequireWithDetect__": {
        //通过刷新缓存寻找航班详情的请求事件
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cstUpdateFlight_infoCard__",
                    "__cmatchFlight_infoTitleWithUpdate__",
                    "__cmatchFlight_infoActionRequireInTitleWithUpdate__"
                ]
            }
        }
    },
    "__conditionFlight_infoActionRequire__": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__findFlight_infoActionRequireWithCache__",
                    "__findFlight_infoActionRequireWithDetect__"
                ]
            }
        }
    },
    "__findActionRequireExcludeAssignCrew__": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cstmatchActionRequireList__",
                    "__tmatchActionRequireExcludeAssignCrew__"
                ]
            }
        }
    }
}
