    "__cmatchmatchFlight_infoBriberySwitchOff__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__conditionFlight_infoActionRequire__",
                "method": 40,
                "lower": [
                    94,
                    45,
                    154
                ],
                "upper": [
                    116,
                    67,
                    176
                ],
                "connected": true,
                "count": 555,
                "order_by": "Vertical",
                "index": -1
            }
        }
    },
    "__tmatchFlight_infoContract_icon__": {
        //放宽匹配阈值，拦住大部分不符，由OCR把控入口
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "__cmatchYellowButton_inFlight_info__",
                "roi_offset": [
                    0,
                    0,
                    0,
                    -110
                ],
                "template": ["合同管理.png"],
                "method": 10001,
                "threshold": 0.6,
                "order_by": "Score"
            }
        }
    },
    "__ocrFlight_infoContractFinish__": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__cmatchYellowButton_inFlight_info__",
                "roi_offset": [
                    0,
                    0,
                    0,
                    -110
                ],
                "expected": [
                    "(?<!\\d)([1-9])\\s*[|/1]\\s*\\1(?!\\d)",
                    "(?<!\\d)10\\s*[|/1]\\s*10(?!\\d)"
                ]
            }
        }
    },
    "__cmatchYellowButton_inFlight_info__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cstGetFlight_infoCard__",
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        }
    },
