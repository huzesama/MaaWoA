    ////------------------HandlingActionRequiring·ActionRequiringList·BEGIN------------------
    "__cstmatchActionRequireList__": {
        //通过ONNX缓存高度为分辨率宽度的ROI
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "airlineCardListColorMatch",
                "custom_recognition_param": {
                    "lower": [
                        13,
                        244,
                        222
                    ],
                    "upper": [
                        35,
                        255,
                        244
                    ],
                    "count": 20
                }
            }
        }
    },
    "__tmatchActionRequireByLowThr__": {
        //低阈值模糊匹配
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "__cstmatchActionRequireList__",
                "template": [
                    "航班类型-请求行动.png"
                ],
                "green_mask": true,
                "method": 10001,
                "threshold": 0.2
            }
        }
    },
    "__detectActionRequire__": {
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "actionRequire",
                "model": "WoA-widget.onnx",
                "threshold": 0.708
            }
        }
    },
    "__tmatchFlight_infoActionRequire__": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "__cstGetFlight_infoCard__",
                "template": "航班信息-请求行动.png",
