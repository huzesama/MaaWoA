    "__tmatchActionRequireExcludeAssignCrew__": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "__cstmatchActionRequireList__",
                "roi_offset": [
                    -5,
                    0,
                    10,
