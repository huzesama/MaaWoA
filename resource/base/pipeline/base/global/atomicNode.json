    //存放内置原始单识别类型的识别节点
    //引用类型的节点，命名以双下划线"__"开头并同样以"__"结尾
    //命名规则: __识别种类[cmatch|tmatch|detect|ocr|classify|cst(custom)...]目标__
    //
    //------------------ROI缓存·BEGIN------------------
    "__cstGetFlight_infoCard__": {
        //缓存航班详细信息卡片
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "roiManager",
                "custom_recognition_param": {
                    "roi_name": "__Flight_infoCard__",
                    "model": "WoA-card.onnx",
                    "expected": "flight_info",
                    "threshold": 0.85
                }
            }
        }
    },
    "__cstUpdateFlight_infoCard__": {
        //更新缓存航班详细信息卡片
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "roiManager",
                "custom_recognition_param": {
                    "roi_name": "__Flight_infoCard__",
                    "model": "WoA-card.onnx",
                    "threshold": 0.85,
                    "expected": "flight_info",
                    "override": true
                }
            }
        }
    },
