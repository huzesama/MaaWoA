{
	"detectPage": { //检测当前所在页面//next列表由base选项unknownPageWaitting覆盖
		"anchor": {
			"afterStart": "finishNode"
		},
		"next": [
			"[JumpBack]detectEntryAirportPage", //进入机场页
			"[JumpBack]detectAirportSelectPage", //机场选择页
			"[JumpBack]detectHomePage", //主页
			"[JumpBack]detectLoadingPage", //加载页面
			"[JumpBack]detectErrorPage", //错误页面
			"restartApp"
		]
	},
	"detectEntryAirportPage": { //检测进入机场后的页面
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-page.onnx",
				"expected": 5
			}
		},
		"next": [
			"startLoopAction"
		]
	},
	"detectAirportSelectPage": { //检测机场IATA选择页面
		"pre_wait_freezes": 0,
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-page.onnx",
				"expected": 4
			}
		},
		"next": [
			"detectAirport_info",
			"detectAitportList"
		]
	},
	"detectHomePage": { //检测主页
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-page.onnx",
				"expected": 2
			}
		},
		"next": [
			"entryAirportSelectPage", //该节点不含next
			"finishNode"
		]
	},
	"detectLoadingPage": { //配合jumpback。检测当前所在页面是否为LoadingPage，自身循环，退出LoadingPage时后续为完成状态，处于LoadingPage则一直等待。
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-page.onnx",
				"expected": 0
			}
		},
		"next": [
			"detectLoadingPage", //该节点不含next
			"finishNode"
		]
	},
	"detectErrorPage": { //错误页
		"recognition": {
			"type": "NeuralNetworkDetect",
			"param": {
				"model": "WoA-page.onnx",
				"expected": 1
			}
		},
		"action": "Click"
	},
	"unattendedMode": { //开始无人值守吧！//被多个节点用于获取全屏实体矩形//由base选项notSkipProcessUp覆盖next
		"anchor": {
			"afterStart": "detectPage"
		},
		"next": [
			"startApp"
		]
	}
}