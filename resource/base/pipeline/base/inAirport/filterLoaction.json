{
    "detectFilter": {
        //默认打开过滤器
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "filter",
                "model": "WoA-widget.onnx"
            }
        },
        "action": "Click",
        "next": [
            "detectFilterActionRequiringButton",
            "detectFilterArrivalButton",
            "detectFilterAirplaneOnAirportButton",
            "detectFilterDepartureButton",
            "detectFilterFavoriteButton",
            "detectFilterUniqueButton",
            "finishNode"
        ],
        "focus": {
            "Node.Node.Action.Starting": "$pipeline.loopAction.detectFilter.focus.action.Starting"
        }
    },
    "detectFilterActionRequiringButton": {
        //默认筛选行动事件
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "filterActionRequire",
                "model": "WoA-widget.onnx"
            }
        },
        "action": "Click",
        "next": [
            "detectFilterArrivalButton",
            "detectFilterAirplaneOnAirportButton",
            "detectFilterDepartureButton",
            "detectFilterFavoriteButton",
            "detectFilterUniqueButton",
            "finishNode"
        ],
        "focus": {
            "Node.Node.Action.Starting": "$pipeline.loopAction.detectFilterActionRequiringButton.focus.action.Starting"
        }
    },
    "detectFilterArrivalButton": {
        //默认取消过滤到达航班
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "filterArrivalPressed",
                "model": "WoA-widget.onnx"
            }
        },
        "action": "Click",
        "next": [
            "detectFilterAirplaneOnAirportButton",
            "detectFilterDepartureButton",
            "detectFilterFavoriteButton",
            "detectFilterUniqueButton",
            "finishNode"
        ]
    },
    "detectFilterAirplaneOnAirportButton": {
        //默认取消过滤在机场航班
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                //expected受选项enabledTower覆写
                "expected": "filterAirplaneOnAirportPressed",
                "model": "WoA-widget.onnx"
            }
        },
        "action": "Click",
        "next": [
            "detectFilterDepartureButton",
            "detectFilterFavoriteButton",
            "detectFilterUniqueButton",
            "finishNode"
        ]
    },
    "detectFilterDepartureButton": {
        //默认取消过滤离场航班
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "filterDeparturePressed",
                "model": "WoA-widget.onnx"
            }
        },
        "action": "Click",
        "next": [
            "detectFilterFavoriteButton",
            "detectFilterUniqueButton",
            "finishNode"
        ]
    },
    "detectFilterFavoriteButton": {
        //默认取消过滤喜爱航班
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "filterFavoritePressed",
                "model": "WoA-widget.onnx"
            }
        },
        "action": "Click",
        "next": [
            "detectFilterUniqueButton",
            "finishNode"
        ]
    },
    "detectFilterUniqueButton": {
        //默认取消过滤特殊入港航班
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "filterUniquePressed",
                "model": "WoA-widget.onnx"
            }
        },
        "action": "Click",
        "target_offset": [
            0,
            0,
            -20,
            -10
        ]
    }
