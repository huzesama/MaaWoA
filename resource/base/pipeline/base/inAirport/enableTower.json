{
    "__locateDockerTowerLED__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cacheDockerTower__",
                "method": 40,
                "lower": [
                    94,
                    145,
                    51
                ],
                "upper": [
                    116,
                    167,
                    73
                ],
                "connected": true,
                "count": 2100,
                "order_by": "Horizontal",
                "index": -1
            }
        }
    },
    "__matchDockerTowerLEDbeGREEN__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__locateDockerTowerLED__",
                "method": 40,
                "lower": [
                    62,
                    133,
                    209
                ],
                "upper": [
                    84,
                    155,
                    231
                ],
                "connected": true,
                "count": 20
            }
        }
    },
    "extendTower": {
        //extend用jumpback属性启动分支,enabled通过选项enabledTower覆写
        "enabled": false,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cacheDockerTower__",
                    "__locateDockerTowerLED__",
                    "__matchDockerTowerLEDbeGREEN__"
                ]
            }
        },
        "inverse": true,
        "next": [
            "extendTowerCondition",
            "finishNode"
        ]
    },
    "__ocrFilterNotZero__": {
        "recognition": "OCR",
        "roi": [
            -70,
            0,
            70,
            0
        ],
        "expected": ["\\(?(\\d+\\/(?!0)\\d+)\\)?"]
    },
    "extendTowerCondition": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cacheDockerTower__",
                    "__ocrFilterNotZero__"
                ]
            }
        },
        "action": "Click",
        "target_offset": [
            30,
            20,
            -60,
            -40
        ],
        "anchor": {
            "page2page.FromPage": "function.disappearing.entryAirportPage",
            "page2page.ToPage": "function.appearing.towerPage",
            "page2page.EntryPageNode": "entryTowerControlCard"
        },
        "next": [
            "function.process.page2page"
        ]
    },
    "detectTower_info": {
        //检测塔台页的延时卡片
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "tower_info",
                "model": "WoA-card.onnx"
            }
        }
    },
    "detectTowerControlEntry": {
        //在延时卡片中点击全部控制器的延时控制卡片
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "detectTower_info",
                "method": 40,
                "lower": [
                    93,
                    19,
                    192
                ],
                "upper": [
                    115,
                    41,
                    214
                ],
                "connected": true,
                "count": 800,
                "order_by": "Vertical",
                "index": -1
            }
        }
    },
    "entryTowerControlCard": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "detectTower_info",
                    "detectTowerControlEntry"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "target_offset": [
            6,
            6,
            -12,
            -12
        ],
        "post_wait_freezes": 100,
        "next": [
            "enableTower",
            "finishNode"
        ]
    },
    "enableTower": {
        //启动塔台延时，暂不考虑速度和启动时长
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        },
        "action": "Click",
        "post_wait_freezes": 200,
        "next": [
            "confirmEnableTower",
            "finishNode"
        ]
    },
    "confirmEnableTower": {
        //点击塔台延时二次确认按钮
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        },
        "action": "Click",
        "post_wait_freezes": 100,
        "next": [
            "[JumpBack]detectLoadingPage",
            "exitTowerPage",
            "finishNode"
        ]
    },
    "exitTowerPage": {
        //退出塔台页面
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cacheMenuButton__",
                "method": 40,
                "lower": [
                    94,
                    145,
                    51
                ],
                "upper": [
                    116,
                    167,
                    73
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Vertical"
            }
        },
        "action": "Click",
        "target_offset": [
            10,
            10,
            -20,
            -20
        ],
        "post_wait_freezes": 100
    }
}
