{
    "__matchActionRequireList__": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "airlineCardListColorMatch",
                "custom_recognition_param": {
                    "lower": [
                        13,
                        244,
                        222
                    ],
                    "upper": [
                        35,
                        255,
                        244
                    ],
                    "count": 20
                }
            }
        }
    },
    "__matchActionRequireByLowThr__": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "__matchActionRequireList__",
                "template": [
                    "航班类型-请求行动.png"
                ],
                "green_mask": true,
                "method": 10001,
                "threshold": 0.2
            }
        }
    },
    "__detectActionRequire__": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__matchActionRequireList__",
                    "__matchActionRequireByLowThr__"
                ]
            }
        }
    },
    "__detectActionRequireByONNX__": {
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "actionRequire",
                "model": "WoA-widget.onnx",
                "threshold": 0.708
            }
        }
    },
    "actionRequiringSelect": {
        //所有行動中隨機選擇action require的flight card//recognition由ONNX选项覆写
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__detectActionRequire__",
                    "__detectActionRequireByONNX__"
                ]
            }
        },
        "action": "Click",
        "anchor": {
            "afterClickFlight_infoYellowButton": "finishNode" //初始化
        },
        "post_wait_freezes": {
            "time": 50,
            "method": 3
        },
        "next": [
            "actionRequireAssignCrew", //分配地勤分支
            "actionRequireStandSelect", //尋找standSelect面板
            "actionRequireBribeFlight", //其它通用的actionRequire先检查有没有开关
            "actionRequireUniversal", //其它通用的actionRequire
            "finishNode"
            //"[JumpBack]isFreezeOrNot"
        ]
    },
    "__matchAssignCrewCardSlideBlock__": {
        //寻找滑块特征
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cacheAssignCrewCard__",
                "method": 40,
                "lower": [
                    62,
                    91,
                    229
                ],
                "upper": [
                    84,
                    113,
                    251
                ],
                "connected": true,
                "count": 400,
                "order_by": "Vertical"
            }
        }
    },
    "__matchAssignCrewCardRampAgentSwitch__": {
        "recognition": {
            //寻找开关特征
            "type": "ColorMatch",
            "param": {
                "roi": "__cacheAssignCrewCardRampAgentSwitch__",
                "method": 40,
                "lower": [
                    94,
                    45,
                    154
                ],
                "upper": [
                    116,
                    67,
                    176
                ],
                "connected": true,
                "count": 300
            }
        }
    },
    "actionRequireAssignCrew": {
        //指派地勤節點鏈,檢測AssignCrew面板
        "recognition": {
            //同时匹配滑块与开关
            "type": "And",
            "param": {
                "all_of": [
                    "__cacheAssignCrewCard__", //无论是否有缓存都至少运行一次确保存在有效BOX
                    "__cacheAssignCrewCardRampAgentSwitch__", //无论是否有缓存都至少运行一次确保存在有效BOX
                    "__matchAssignCrewCardSlideBlock__",
                    "__matchAssignCrewCardRampAgentSwitch__"
                ],
                "box_index": 2
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": true,
                "begin_offset": [
                    2,
                    2,
                    -4,
                    -4
                ],
                "end": "actionRequiringSelect", //选择的flight Card action requiring位置
                "duration": 200
            }
        },
        "next": [
            "ClickRampAgentSwitch",
            "finishNode"
        ]
    },
    "ClickRampAgentSwitch": {
        //指派地勤節點鏈,尋找並打開Ramp Agent
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__cacheAssignCrewCardRampAgentSwitch__"
                ]
            }
        },
        "action": "Click",
        "target_offset": [
            2,
            2,
            -4,
            -4
        ],
        "next": [
            "handlingAssignCrew",
            "updateCrewUsedBefore",
            "finishNode"
        ]
    },
    "__matchFlight_infoTimeLimitPass": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "__cacheFlight_infoCard__",
                "template": [
                    "航班信息-时限通过.png"
                ],
                "green_mask": true,
                "method": 10001,
                "threshold": 0.8
            }
        }
    },
    "__matchAssignCrewCardPlusButtonBeGray__": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "__cacheAssignCrewCard__",
                "template": [
                    "加号（灰）.png"
                ],
                "green_mask": true,
                "method": 10001,
                "threshold": 0.8
            }
        }
    },
    "__conditionAssignCrewPass__": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__matchFlight_infoTimeLimitPass",
                    "__matchAssignCrewCardPlusButtonBeGray__"
                ]
            }
        }
    },
    "__conditionAssignCrewCardRampAgentOn__": {
        "recognition": {
            //检查rampAgent是否启用
            "type": "ColorMatch",
            "param": {
                "roi": "__cacheAssignCrewCardRampAgentSwitch__",
                "method": 40,
                "lower": [
                    62,
                    133,
                    200
                ],
                "upper": [
                    84,
                    155,
                    222
                ],
                "connected": true,
                "count": 300,
                "order_by": "Horizontal"
            }
        }
    },
    "handlingAssignCrew": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cacheFlight_infoCard__", //无论是否有缓存都至少运行一次确保存在有效BOX
                    "__cacheAssignCrewCard__", //无论是否有缓存都至少运行一次确保存在有效BOX
                    "__cacheAssignCrewCardRampAgentSwitch__", //无论是否有缓存都至少运行一次确保存在有效BOX
                    "__conditionAssignCrewPass__",
                    "__conditionAssignCrewCardRampAgentOn__"
                ]
            }
        },
        "next": [
            "clickFlight_infoYellowButton",
            "finishNode"
        ]
    },
    "__standSelectMatch__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cacheStandSelectCard__",
                "method": 40,
                "lower": [
                    93,
                    19,
                    192
                ],
                "upper": [
                    115,
                    41,
                    214
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Horizontal" //由base选项randomSelectStand覆写
            }
        }
    },
    "__plannerStandSelectMatch__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cacheStandSelectCard__",
                "method": 40,
                "lower": [
                    84,
                    244,
                    244
                ],
                "upper": [
                    106,
                    255,
                    255
                ],
                "connected": true,
                "count": 400,
                "order_by": "Horizontal"
            }
        }
    },
    "actionRequireStandSelect": {
        //机位分配的节点链，匹配stand select面板
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cacheStandSelectCard__", //无论是否有缓存都至少运行一次确保存在有效BOX
                    {
                        "recognition": {
                            "type": "Or",
                            "param": {
                                "any_of": [
                                    "__standSelectMatch__",
                                    "__plannerStandSelectMatch__"
                                ]
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "next": [
            "clickFlight_infoYellowButton",
            "baseStandSelect", //基本
            "otherStandSelect", //当前界面既不满足规划器预选也不满足存在可选机位的兜底选择
            "finishNode"
        ]
    },
    "baseStandSelect": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__standSelectMatch__"
                ]
            }
        },
        "action": "Click",
        "target_offset": [
            10,
            10,
            -20,
            -20
        ],
        "post_wait_freezes": 50,
        "next": [
            "clickFlight_infoYellowButton",
            "finishNode"
        ]
    },
    "__matchStandSelectListSlider__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cacheStandSelectCard__",
                "method": 40,
                "lower": [
                    94,
                    45,
                    154
                ],
                "upper": [
                    116,
                    67,
                    176
                ],
                "connected": true,
                "count": 20,
                "order_by": "Vertical",
                "index": -1
            }
        }
    },
    //当前界面既不满足规划器预选也不满足存在可选机位的兜底选择
    "otherStandSelect": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cacheStandSelectCard__",
                    "__matchStandSelectListSlider__"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "end": [
                    10,
                    10,
                    10,
                    700
                ],
                "duration": 300
            }
        },
        "post_wait_freezes": {
            "time": 50,
            "target": "actionRequireStandSelect"
        },
        "next": [
            "baseStandSelect",
            "finishNode"
        ]
    },
    "__updateFlight_infoCardCache__": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "roiManager",
                "custom_recognition_param": {
                    "roi_name": "__cacheFlight_infoCard__",
                    "model": "WoA-card.onnx",
                    "threshold": 0.95,
                    "expected": "flight_info",
                    "override": true
                }
            }
        }
    },
    "__matchFlight_infoActionRequire__": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "航班信息-请求行动.png",
                "green_mask": true,
                "method": 10001,
                "threshold": 0.8
            }
        }
    },
    "__conditionFlight_infoActionRequire__": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    "__cacheFlight_infoCard__",
                                    "__matchFlight_infoActionRequire__"
                                ]
                            }
                        }
                    },
                    "__updateFlight_infoCardCache__"
                ]
            }
        }
    },
    "matchFlight_infoBriberySwitchOff": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__matchFlight_infoActionRequire__",
                "method": 40,
                "lower": [
                    94,
                    45,
                    154
                ],
                "upper": [
                    116,
                    67,
                    176
                ],
                "connected": true,
                "count": 555,
                "order_by": "Vertical",
                "index": -1
            }
        }
    },
    "actionRequireBribeFlight": {
        "enabled": true,
        //检测是否存在开关例如需要贿赂的超时处理离场航班//enabled由bribery选项覆写
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__conditionFlight_infoActionRequire__",
                    "matchFlight_infoBriberySwitchOff"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "target_offset": [
            2,
            2,
            -4,
            -4
        ],
        "next": [
            "actionRequireUniversal"
        ]
    },
    "actionRequireUniversal": {
        //指派地勤行動外的節點鏈
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    "__cacheFlight_infoCard__",
                                    "__matchFlight_infoActionRequire__"
                                ]
                            }
                        }
                    },
                    "__updateFlight_infoCardCache__"
                ]
            }
        },
        "next": [
            "upgradeContract",
            "clickFlight_infoYellowButton",
            "detectFilterActionRequiringButton", //遇到不可点击的flight card检测是否过滤请求行动筛选
            "finishNode"
        ]
    },
    "__matchFlight_infoContract_icon__": {
        "recognition": "TemplateMatch",
        "roi": "__cacheFlight_infoCard__",
        "template": ["合同管理.png"],
        "method": 10001,
        "threshold": 0.7,
        "order_by": "Score"
    },
    "upgradeContract": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    "__cacheFlight_infoCard__",
                                    "__matchFlight_infoContract_icon__"
                                ]
                            }
                        }
                    },
                    "__updateFlight_infoCardCache__"
                ]
            }
        },
        "anchor": {
            "afterClickFlight_infoYellowButton": "detectContractUpgradeCard"
        },
        "next": [
            "clickFlight_infoYellowButton",
            "detectContractUpgradeCard", //仍存在可能上一轮clickFlight_infoYellowButton没有检测到ContractUpgradeCard的情况
            "finishNode"
        ]
    },
    "__matchYellowButton_inFlight_info__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cacheFlight_infoCard__",
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        }
    },
    "clickFlight_infoYellowButton": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    "__cacheFlight_infoCard__", //无论是否有缓存都至少运行一次确保存在有效BOX
                                    "__matchYellowButton_inFlight_info__"
                                ],
                                "box_index": 1
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    "__updateFlight_infoCardCache__",
                                    "__matchYellowButton_inFlight_info__"
                                ],
                                "box_index": 1
                            }
                        }
                    }
                ]
            }
        },
        "action": "Click",
        "target_offset": [
            5,
            5,
            -10,
            -10
        ],
        "post_wait_freezes": {
            "time": 200,
            "target_offset": [
                10,
                10,
                -20,
                -20
            ],
            "method": 5
        },
        "next": [
            "[JumpBack]detectLoadingPage",
            "[Anchor]afterClickFlight_infoYellowButton",
            "finishNode" //考虑去除，但需要同时考虑检测合同升级可能会出现的网络异常Page跳转问题，当前的检测将会一直等待卡片
        ]
    },
    "__matchYellowButton_inUpgradeCard__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cacheContractUpgradeCard__",
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        }
    },
    "detectContractUpgradeCard": {
        //檢測是否是延續升級合同的卡片
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cacheContractUpgradeCard__", //无论是否有缓存都至少运行一次确保存在有效BOX
                    "__matchYellowButton_inUpgradeCard__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "target_offset": [
            5,
            5,
            -10,
            -10
        ],
        "anchor": {
            "afterClickFlight_infoYellowButton": "finishNode" //被分配的anchor被前置节点使用后立即清除
        },
        "next": [
            "[JumpBack]waitContractUpgradeCardDisappear",
            "finishNode"
        ]
    },
    "waitContractUpgradeCardDisappear": {
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "contractUpgradeCard",
                "model": "WoA-card.onnx"
            }
        }
    },
    "__matchActionRequireExcludeAssignCrew__": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "__matchActionRequireList__",
                "roi_offset": [
                    -5,
                    0,
                    10,
                    0
                ],
                "template": [
                    "航班类型-离场.png",
                    "航班类型-到达.png",
                    "航班类型-维修.png"
                ],
                "green_mask": true,
                "method": 10001,
                "threshold": 0.8
            }
        }
    },
    "__matchActionRequireExcludeAssignCrewByONNX__": {
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": [
                    "arrival",
                    "departure",
                    "repair",
                    "ice"
                ],
                "model": "WoA-widget.onnx"
            }
        }
    },
    "actionRequiringSelectDeparture": {
        //选择departure//recognition由ONNX选项覆写
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    "__matchActionRequireList__",
                                    "__matchActionRequireExcludeAssignCrew__"
                                ]
                            }
                        }
                    },
                    "__matchActionRequireExcludeAssignCrewByONNX__"
                ]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 50,
            "method": 3
        },
        "next": [
            "actionRequireStandSelect",
            "actionRequireBribeFlight",
            "actionRequireUniversal",
            "finishNode"
        ]
    }
}
