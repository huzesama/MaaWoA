{
    "startLoopAction": {
        //开始行动请求的处理循环
        "next": [
            "[JumpBack]actionRequiringSelect",
            "[JumpBack]detectFilter", //过滤器筛选的准备
            "[JumpBack]actionRequiringSelectDeparture", //actionRequiringSelectDeparture必须在过滤器筛选准备后
            "[JumpBack]entryDocker",
            "finishWithDelay" //跳回detectPage节点
        ]
    },
    "entryDocker": {
        "enabled": false, // 由base选项dockExtra覆写
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyEntryAirportPage__"
                ]
            }
        },
        "next": [
            "disappearingFlightCard_info",
            "dockerFunction",
            "finishWithDelay"
        ]
    },
    "disappearingFlightCard_info": {
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": [
                    "docker"
                ],
                "model": "WoA-card.onnx"
            }
        },
        "inverse": true,
        "action": "Click",
        "target": "cacheCrewUsedBox",
        "target_offset": [
            120,
            160,
            0,
            0
        ],
        "repeat": 2,
        "repeat_delay": 200,
        "next": [
            "dockerFunction"
        ]
    },
    "dockerFunction": {
        // next node的enabled应默认false
        "next": [
            "extendTower",
            "finishWithDelay"
        ]
    }
}
