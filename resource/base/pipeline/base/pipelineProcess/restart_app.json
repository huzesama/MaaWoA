{
    "startApp": {
        "action": "StartApp",
        "package": "com.haugland.woa",
        "anchor": {
            "afterStop": "finishNode"
        },
        "next": [
            "[Anchor]afterStart"
        ],
        "focus": {
            "Node.Action.Succeeded": "$pipeline.restartApp.focus.Node.Action.Succeeded",
            "Node.Action.Failed": {
                "content": "$pipeline.restartApp.focus.Node.Action.Failed",
                "display": [
                    "log",
                    "toast",
                    "dialog",
                    "notification"
                ]
            }
        }
    },
    "stopApp": {
        "action": "StopApp",
        "package": "com.haugland.woa",
        "next": [
            "[Anchor]afterStop"
        ],
        "focus": {
            "Node.Action.Succeeded": "$pipeline.restartApp.focus.Node.Action.Succeeded",
            "Node.Action.Failed": {
                "content": "$pipeline.restartApp.focus.Node.Action.Failed",
                "display": [
                    "log",
                    "toast",
                    "dialog",
                    "notification"
                ]
            }
        }
    },
    "restartApp": {
        "anchor": {
            "afterStop": "startApp",
            "afterStart": "detectPage"
        },
        "next": [
            "stopApp"
        ],
        "focus": {
            "Node.Action.Starting": "$pipeline.restartApp.focus.Node.Action.Starting",
            "Node.Action.Failed": {
                "content": "$pipeline.restartApp.focus.Node.Action.Failed",
                "display": [
                    "log",
                    "toast",
                    "dialog",
                    "notification"
                ]
            }
        }
    }
}
