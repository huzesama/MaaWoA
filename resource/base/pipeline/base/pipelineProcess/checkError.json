                ]
            }
        }
    },
    "checkBack": {
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "back",
                "model": "MaaWoA-widget.onnx"
            }
        },
        "action": "Click",
        "target_offset": [
            20,
            20,
            -40,
            -40
