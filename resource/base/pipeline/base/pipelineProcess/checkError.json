        "next": [
            "detectPage"
        ]
    },
    "checkUpgradeCard": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "NeuralNetworkDetect",
                            "param": {
                                "expected": "contractUpgradeCard",
                                "model": "MaaWoA-card.onnx"
                            }
                        }
                    },
                    "__cmatchYellowButtonNoROI__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "post_wait_freezes": 200,
        "next": [
            "detectPage"
        ]
    }
