        "recognition": {
            "type": "NeuralNetworkClassify",
            "param": {
                "expected": "errorPage",
                "model": "WoA-page-cls.onnx",
                "labels": [
                    "airportSelectPage",
                    "contractPage",
                    "entryAirportPage",
                    "errorPage",
                    "homePage",
                    "loadingPage",
                    "setPage",
                    "towerPage"
