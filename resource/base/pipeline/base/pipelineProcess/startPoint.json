                "expected": "entryAirportPage",
                "model": "WoA-page-cls.onnx",
                "labels": [
                    "airportSelectPage",
                    "contractPage",
                    "entryAirportPage",
                    "errorPage",
                    "homePage",
                    "loadingPage",
                    "setPage",
                    "towerPage"
                ]
            }
        },
        "next": [
            "startLoopAction"
        ]
    },
    "detectAirportSelectPage": {
        "recognition": {
            "type": "NeuralNetworkClassify",
            "param": {
                "expected": "airportSelectPage",
                "model": "WoA-page-cls.onnx",
                "labels": [
                    "airportSelectPage",
                    "contractPage",
                    "entryAirportPage",
                    "errorPage",
                    "homePage",
                    "loadingPage",
                    "setPage",
                    "towerPage"
