    "detectHomePage": {
        //检测主页
        "recognition": {
            "type": "NeuralNetworkClassify",
            "param": {
                "expected": "homePage",
                "model": "WoA-page-cls.onnx",
                "labels": [
                    "airportSelectPage",
                    "contractPage",
                    "entryAirportPage",
