{
    "detectPage": {
        //检测当前所在页面//next列表由base选项unknownPageWaitting覆盖
        "anchor": {
            "afterStart": "finishNode"
        },
        "timeout": 8000,
        "rate_limit": 2000,
        "next": [
            "[JumpBack]detectEntryAirportPage", //进入机场页
            "[JumpBack]detectAirportSelectPage", //机场选择页
            "[JumpBack]detectHomePage", //主页
            "[JumpBack]detectLoadingPage", //加载页面
            "[JumpBack]detectErrorPage" //错误页面
        ],
        "on_error": [
            "checkAll"
        ]
    },
    "detectEntryAirportPage": {
        //检测进入机场后的页面
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyEntryAirportPage__"
                ]
            }
        },
        "next": [
            "startLoopAction"
        ]
    },
    "detectAirportSelectPage": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyAirportSelectPage__"
                ]
            }
        },
        "timeout": 8,
        //检测机场IATA选择页面
        "next": [
            "detectAirport_info",
            "detectAitportList"
        ],
        "on_error": [
            "finishWithDelay"
        ]
    },
    "detectHomePage": {
        //检测主页
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyHomePage__"
                ]
            }
        },
        "next": [
            "entryAirportSelectPage", //该节点不含next
            "finishWithDelay"
        ]
    },
    "detectErrorPage": {
        //错误页
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__classifyErrorPage__",
                    "__cmatchErrorPageUniversalConfirm__"
                ],
                "box_index": 1
            }
        },
        "action": "Click"
    },
    "unattendedMode": {
        "anchor": {
            "afterStart": "detectPage"
        },
        "next": [
            "startApp"
        ]
    }
}
