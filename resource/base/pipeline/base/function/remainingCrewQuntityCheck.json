{
    "compareCrewUsed": {
        //对比crew used，不相等时未命中
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "crewUsedCompare",
                "custom_recognition_param": {
                    "update_cache": false
                }
            }
        },
        "next": [
            "actionRequiringSelect",
            "finishNode"
        ]
    },
    "updateCrewUsedBefore": {
        "action": "Click",
        //用于释放选择但未分配的地勤
        "target": "actionRequiringSelect",
        "next": [
            "updateCrewUsed",
            "finishNode"
        ]
    },
    "updateCrewUsed": {
        //使用and类型更新缓存记录
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "crewUsedCompare",
                "custom_recognition_param": {
                    "update_cache": true
                }
            }
        },
        "focus": {
            "Node.Recognition.Starting": "$pipeline.remainingCrewQuntityCheck.updateCrewUsed.focus.Node.Recognition.Starting"
        }
    }
}
