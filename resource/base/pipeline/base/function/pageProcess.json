{
    // 页面过渡的流水线
    // 由三段锚点控制走向
    "function.process.page2page": {
        // page2page.FromPage 跳转前所处的页面
        // page2page.ToPage 跳转后所处的页面
        // page2page.EntryPageNode 完成页面过渡后进入的节点
        // page2page.whenError 控制过渡页面走on_error的节点
        "next": [
            "[Anchor]page2page.FromPage",
            "function.process.middlePage",
            "[Anchor]page2page.ToPage"
        ],
        "on_error": [
            "[Anchor]page2page.whenError"
        ],
        "focus": {
            "Node.NextList.Starting": "$pipeline.process.function.process.page2page.focus.Node.NextList.Starting",
            "Node.NextList.Failed": "$pipeline.process.function.process.page2page.focus.Node.NextList.Failed"
        }
    },
    "function.process.middlePage": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyLoadingPage__"
                ]
            }
        },
        "pre_delay": 500,
        "next": [
            "function.process.middlePage",
            "[Anchor]page2page.ToPage"
        ],
        "on_error": [
            "[Anchor]page2page.whenError"
        ]
    },
    "function.disappearing.homePage": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyHomePage__"
                ]
            }
        },
        "next": [
            "function.process.middlePage",
            "[Anchor]page2page.ToPage"
        ],
        "on_error": [
            "[Anchor]page2page.whenError"
        ],
        "focus": {
            "Node.NextList.Starting": "$pipeline.process.function.disappearing.homePage.focus.Node.NextList.Starting",
            "Node.NextList.Failed": "$pipeline.process.function.process.page2page.focus.Node.NextList.Failed"
        }
    },
    "function.disappearing.airportSelecPage": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyAirportSelectPage__"
                ]
            }
        },
        "next": [
            "function.process.middlePage",
            "[Anchor]page2page.ToPage"
        ],
        "on_error": [
            "[Anchor]page2page.whenError"
        ],
        "focus": {
            "Node.NextList.Starting": "$pipeline.process.function.disappearing.airportSelecPage.focus.Node.NextList.Starting",
            "Node.NextList.Failed": "$pipeline.process.function.process.page2page.focus.Node.NextList.Failed"
        }
    },
    "function.disappearing.entryAirportPage": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyEntryAirportPage__"
                ]
            }
        },
        "next": [
            "function.process.middlePage",
            "[Anchor]page2page.ToPage"
        ],
        "on_error": [
            "[Anchor]page2page.whenError"
        ],
        "focus": {
            "Node.NextList.Starting": "$pipeline.process.function.disappearing.entryAirportPage.focus.Node.NextList.Starting",
            "Node.NextList.Failed": "$pipeline.process.function.process.page2page.focus.Node.NextList.Failed"
        }
    },
    "function.disappearing.towerPage": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyTowerPage__"
                ]
            }
        },
        "next": [
            "function.process.middlePage",
            "[Anchor]page2page.ToPage"
        ],
        "on_error": [
            "[Anchor]page2page.whenError"
        ],
        "focus": {
            "Node.NextList.Starting": "$pipeline.process.function.disappearing.towerPage.focus.Node.NextList.Starting",
            "Node.NextList.Failed": "$pipeline.process.function.process.page2page.focus.Node.NextList.Failed"
        }
    },
    "function.appearing.homePage": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyHomePage__"
                ]
            }
        },
        "next": ["[Anchor]page2page.EntryPageNode"],
        "on_error": [
            "[Anchor]page2page.whenError"
        ],
        "focus": {
            "Node.NextList.Starting": "$pipeline.process.function.appearing.homePage.focus.Node.NextList.Starting",
            "Node.NextList.Failed": "$pipeline.process.function.process.page2page.focus.Node.NextList.Failed"
        }
    },
    "function.appearing.airportSelecPage": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyAirportSelectPage__"
                ]
            }
        },
        "next": ["[Anchor]page2page.EntryPageNode"],
        "on_error": [
            "[Anchor]page2page.whenError"
        ],
        "focus": {
            "Node.NextList.Starting": "$pipeline.process.function.appearing.airportSelecPage.focus.Node.NextList.Starting",
            "Node.NextList.Failed": "$pipeline.process.function.process.page2page.focus.Node.NextList.Failed"
        }
    },
    "function.appearing.entryAirportPage": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyEntryAirportPage__"
                ]
            }
        },
        "next": ["[Anchor]page2page.EntryPageNode"],
        "on_error": [
            "[Anchor]page2page.whenError"
        ],
        "focus": {
            "Node.NextList.Starting": "$pipeline.process.function.appearing.entryAirportPage.focus.Node.NextList.Starting",
            "Node.NextList.Failed": "$pipeline.process.function.process.page2page.focus.Node.NextList.Failed"
        }
    },
    "function.appearing.towerPage": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__classifyTowerPage__"
                ]
            }
        },
        "next": ["[Anchor]page2page.EntryPageNode"],
        "on_error": [
            "[Anchor]page2page.whenError"
        ],
        "focus": {
            "Node.NextList.Starting": "$pipeline.process.function.appearing.towerPage.focus.Node.NextList.Starting",
            "Node.NextList.Failed": "$pipeline.process.function.process.page2page.focus.Node.NextList.Failed"
        }
    }
}
