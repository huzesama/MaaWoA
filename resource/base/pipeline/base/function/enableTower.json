{
    "extendTower": {
        //extend用jumpback属性启动分支,enabled通过选项enableTower覆写
        "enabled": false,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cstGetDockerTower__",
                    "__locateDockerTowerLED__",
                    "__matchDockerTowerLEDbeRED__",
                    "__ocrFilterNotZero__"
                ]
            }
        },
        "action": "Click",
        "target_offset": [
            30,
            20,
            -60,
            -40
        ],
        "anchor": {
            "page2page.FromPage": "function.disappearing.entryAirportPage",
            "page2page.ToPage": "function.appearing.towerPage",
            "page2page.EntryPageNode": "entryTowerControlCard",
            "page2page.whenError": "entryTowerControlCard"
        },
        "next": [
            "function.process.page2page"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$pipeline.enableTower.extendTower.focus.Node.Recognition.Succeeded"
        }
    },
    "entryTowerControlCard": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__detectTower_info__",
                    "__detectTowerControlEntry__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "target_offset": [
            6,
            6,
            -12,
            -12
        ],
        "post_wait_freezes": 100,
        "next": [
            "enableTower",
            "finishWithCapture"
        ]
    },
    "enableTower": {
        //启动塔台延时，暂不考虑速度和启动时长
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        },
        "action": "Click",
        "post_wait_freezes": 200,
        "next": [
            "confirmEnableTower",
            "finishNode"
        ]
    },
    "confirmEnableTower": {
        //点击塔台延时二次确认按钮
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        },
        "action": "Click",
        "post_wait_freezes": 100,
        "next": [
            "[JumpBack]detectLoadingShortOnce",
            "exitTowerPage",
            "finishNode"
        ]
    },
    "exitTowerPage": {
        //退出塔台页面
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "cacheMenuButton",
                "method": 40,
                "lower": [
                    94,
                    145,
                    51
                ],
                "upper": [
                    116,
                    167,
                    73
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Vertical"
            }
        },
        "action": "Click",
        "target_offset": [
            10,
            10,
            -20,
            -20
        ],
        "post_wait_freezes": 100,
        "focus": {
            "Node.Recognition.Succeeded": "$pipeline.enableTower.exitTowerPage.focus.Node.Recognition.Succeeded"
        }
    }
}
