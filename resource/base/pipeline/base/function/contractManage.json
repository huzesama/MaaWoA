{
    ///atomic
    "__tmachUniversalBackButtonDarkBackground__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                //"roi": "cacheMenuButton",
                "method": 40,
                "lower": [
                    94,
                    145,
                    51
                ],
                "upper": [
                    116,
                    167,
                    73
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Vertical"
            }
        }
    },
    "__cmatchSubMenuRedPoint__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cstReverseSubMenu__",
                "method": 40,
                "lower": [
                    [
                        179,
                        180,
                        219
                    ],
                    [
                        0,
                        180,
                        219
                    ]
                ],
                "upper": [
                    [
                        179,
                        182,
                        221
                    ],
                    [
                        1,
                        182,
                        221
                    ]
                ],
                "connected": true
            }
        }
    },
    "__cmatchSubMenuSelected__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 40,
                "lower": [
                    23,
                    254,
                    232
                ],
                "upper": [
                    25,
                    255,
                    234
                ],
                "connected": true,
                "count": 80,
                "order_by": "Vertical",
                "index": -1
            }
        }
    },
    "__cstReverseSubMenu__": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "rectOffset",
                "custom_recognition_param": {
                    "node_name": "__cmatchSubMenuSelected__",
                    "offset": [
                        "-x",
                        0,
                        "-w+W",
                        "-y+H"
                    ]
                }
            }
        }
    },
    "__detectUPContracts__": {
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": [
                    "playersContractOffers",
                    "uniqueContractOffers"
                ],
                "model": "MaaWoA-card.onnx"
            }
        }
    },
    "__cmatchYellowButtonByROI__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "[Anchor]__anchor.YellowButtonByROI__",
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        }
    },
    "__cmatchYellowButtonNoROI__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        }
    },
    "__cmatchContractActionRequireForeground__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cmatchContractActionRequireBackground__",
                "method": 40,
                "lower": [
                    3,
                    205,
                    239
                ],
                "upper": [
                    5,
                    207,
                    241
                ],
                "connected": true,
                "count": 140,
                "order_by": "Vertical"
            }
        }
    },
    "__cmatchContractActionRequireForegroundPress__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__cmatchContractActionRequireBackgroundPress__",
                "method": 40,
                "lower": [
                    3,
                    205,
                    239
                ],
                "upper": [
                    5,
                    207,
                    241
                ],
                "connected": true,
                "count": 140,
                "order_by": "Vertical"
            }
        }
    },
    "__cmatchContractActionRequireBackground__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 40,
                "lower": [
                    103,
                    29,
                    202
                ],
                "upper": [
                    105,
                    31,
                    204
                ],
                "connected": true,
                "count": 444,
                "order_by": "Vertical"
            }
        }
    },
    "__cmatchContractActionRequireBackgroundPress__": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 40,
                "lower": [
                    104,
                    77,
                    100
                ],
                "upper": [
                    106,
                    79,
                    102
                ],
                "connected": true,
                "count": 444,
                "order_by": "Vertical"
            }
        }
    },

    ///molecular
    "__getSubMenu__": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cmatchSubMenuSelected__",
                    "__cstReverseSubMenu__" //反算二级菜单ROI
                ]
            }
        }
    },

    //main pipeline
    "check&entryContractManagerRedPoint": {
        //流水线的任务链分支，通过jumpback进入
        "enabled": false,
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "dockerContractNotice",
                "model": "MaaWoA-widget.onnx"
            }
        },
        "action": "Click",
        "anchor": {
            "__anchor.YellowButtonByROI__": "__detectUPContracts__"
        },
        "next": [
            "selectSubmenuRedPoint",
            "exitContractsManager",
            "finishWithCapture"
        ]
    },
    "selectSubmenuRedPoint": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__getSubMenu__",
                    "__cmatchSubMenuRedPoint__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "next": [
            "contractActionRequirePressed",
            "contractActionRequireNotPressed",
            "contractClaimBranch"
        ]
    },
    "contractActionRequirePressed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cmatchContractActionRequireBackgroundPress__",
                    "__cmatchContractActionRequireForegroundPress__"
                ],
                "box_index": 1
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "method": 3,
            "timeout": 5000
        },
        "next": [
            "[JumpBack]claimContractsRewardInContractsManager",
            "exitContractsManager"
        ]
    },
    "contractActionRequireNotPressed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cmatchContractActionRequireBackground__",
                    "__cmatchContractActionRequireForeground__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 500,
            "method": 3,
            "timeout": 5000
        },
        "next": [
            "[JumpBack]claimContractsRewardInContractsManager",
            "exitContractsManager"
        ]
    },
    "claimContractsRewardInContractsManager": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cmatchYellowButtonNoROI__"
                ]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 500,
            "method": 3,
            "timeout": 5000
        },
        "next": [
            "[JumpBack]detectLoadingShortOnce",
            "handlingContractUpgradeCard",
            "finishNode" //合同管理界面的领取并升级合同概率为只领取奖励不升级，此轮操作结束会出现仅升级合同按钮不会弹出合同升级卡片
        ]
    },
    //---------------------------------------------------------
    //------------------CLAIM ONE OFFER·BEGIN------------------
    //---------------------------------------------------------
    "contractClaimBranch": {
        "next": [
            "[JumpBack]claimOneContractOffers",
            "detectContractAcceptConfirmCard",
            "exitContractsManager"
        ]
    },
    "claimOneContractOffers": {
        //检测特殊入港合同卡片
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__detectUPContracts__",
                    "__cmatchYellowButtonByROI__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "target_offset": [
            5,
            5,
            -10,
            -10
        ],
        "post_delay": 500,
        "next": [
            "detectContractAcceptConfirmCard",
            "finishNode"
        ]
    },
    "detectContractAcceptConfirmCard": {
        //检测合同确认卡片的box
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "contractAcceptConfirmCard",
                "model": "MaaWoA-card.onnx"
            }
        },
        "next": [
            "acceptContractOfferConfirm"
        ]
    },
    "acceptContractOfferConfirm": {
        //点击确认
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "detectContractAcceptConfirmCard",
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        },
        "action": "Click",
        "target_offset": [
            5,
            5,
            -10,
            -10
        ],
        "next": [
            "[JumpBack]detectLoadingShortOnce",
            "finishNode"
        ]
    },
    //---------------------------------------------------------
    //------------------CLAIM ONE OFFER·END------------------
    //---------------------------------------------------------
    "exitContractsManager": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["__tmachUniversalBackButtonDarkBackground__"]
            }
        },
        "action": "Click",
        "target_offset": [
            10,
            10,
            -20,
            -20
        ],
        "post_wait_freezes": 100
    }
}
