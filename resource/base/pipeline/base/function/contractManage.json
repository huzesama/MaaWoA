{
    "check&entryContractManagerRedPoint": {
        //流水线的任务链分支，通过jumpback进入
        "enabled": false,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cstGetContractsManager__",
                    "__cmatchContractsManagerLocation__",
                    "__cmatchContractsManagerRedPoint__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "anchor": {
            "__anchor.YellowButtonByROI__": "__detectUPContracts__"
        },
        "post_wait_freezes": 200,
        "next": [
            "selectSubmenuRedPoint"
        ],
        "on_error": [
            "exitContractsManager",
            "detectPage"
        ]
    },
    "selectSubmenuRedPoint": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__getContractManagerSubMenu__",
                    "__cmatchSubMenuRedPoint__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "next": [
            "contractActionRequirePressed",
            "contractActionRequireNotPressed",
            "contractClaimBranch"
        ]
    },
    "contractActionRequirePressed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cmatchContractActionRequireBackgroundPress__",
                    "__cmatchContractActionRequireForegroundPress__"
                ],
                "box_index": 1
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "method": 3,
            "timeout": 5000
        },
        "next": [
            "[JumpBack]claimContractsRewardInContractsManager",
            "exitContractsManager"
        ]
    },
    "contractActionRequireNotPressed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cmatchContractActionRequireBackground__",
                    "__cmatchContractActionRequireForeground__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 500,
            "method": 3,
            "timeout": 5000
        },
        "next": [
            "[JumpBack]claimContractsRewardInContractsManager",
            "exitContractsManager"
        ]
    },
    "claimContractsRewardInContractsManager": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__cmatchYellowButtonNoROI__"
                ]
            }
        },
        "action": "Click",
        "post_wait_freezes": {
            "time": 500,
            "method": 3,
            "timeout": 5000
        },
        "next": [
            "[JumpBack]detectLoadingShortOnce",
            "handlingContractUpgradeCard",
            "finishNode" //合同管理界面的领取并升级合同概率为只领取奖励不升级，此轮操作结束会出现仅升级合同按钮不会弹出合同升级卡片
        ]
    },
    //---------------------------------------------------------
    //------------------CLAIM ONE OFFER·BEGIN------------------
    //---------------------------------------------------------
    "contractClaimBranch": {
        "next": [
            "[JumpBack]claimOneContractOffers",
            "detectContractAcceptConfirmCard",
            "exitContractsManager"
        ]
    },
    "claimOneContractOffers": {
        //检测特殊入港合同卡片
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__detectUPContracts__",
                    "__cmatchYellowButtonByROI__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "target_offset": [
            5,
            5,
            -10,
            -10
        ],
        "post_delay": 500,
        "next": [
            "detectContractAcceptConfirmCard",
            "finishNode"
        ]
    },
    "detectContractAcceptConfirmCard": {
        //检测合同确认卡片的box
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "contractAcceptConfirmCard",
                "model": "MaaWoA-card.onnx"
            }
        },
        "next": [
            "acceptContractOfferConfirm"
        ]
    },
    "acceptContractOfferConfirm": {
        //点击确认
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "detectContractAcceptConfirmCard",
                "method": 40,
                "lower": [
                    13,
                    244,
                    222
                ],
                "upper": [
                    35,
                    255,
                    244
                ],
                "connected": true,
                "count": 2000,
                "order_by": "Area"
            }
        },
        "action": "Click",
        "target_offset": [
            5,
            5,
            -10,
            -10
        ],
        "next": [
            "[JumpBack]detectLoadingShortOnce",
            "finishNode"
        ]
    },
    //---------------------------------------------------------
    //------------------CLAIM ONE OFFER·END------------------
    //---------------------------------------------------------
    "exitContractsManager": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["__tmachUniversalBackButtonDarkBackground__"]
            }
        },
        "action": "Click",
        "target_offset": [
            10,
            10,
            -20,
            -20
        ],
        "post_wait_freezes": 100
    }
}
