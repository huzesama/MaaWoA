{
    "option": {
        "ONNX": {
            "type": "select",
            //减少使用ONNX
            "label": "$pi.task.option.ONNX.name",
            "description": "$pi.task.option.ONNX.description",
            "cases": [
                {
                    //自动回退为直接对pipeline改动无需pipeline_override
                    "name": "default",
                    "label": "$pi.task.option.ONNX.default.name",
                    "description": "$pi.task.option.ONNX.default.description"
                },
                {
                    "name": "reduceONNX",
                    "label": "$pi.task.option.ONNX.reduceONNX.name",
                    "description": "$pi.task.option.ONNX.reduceONNX.description",
                    "pipeline_override": {
                        "actionRequiringSelect": {
                            //REDUCE ONNX OPTION
                            "recognition": {
                                "type": "And",
                                "param": {
                                    "all_of": [
                                        "__cstCompareCrewUsed__",
                                        "__findActionRequire__"
                                    ],
                                    "box_index": 1
                                }
                            }
                        },
                        "actionRequiringSelectDeparture": {
                            //REDUCE ONNX OPTION
                            "recognition": {
                                "type": "Or",
                                "param": {
                                    "any_of": [
                                        "__findActionRequireExcludeAssignCrew__"
                                    ]
                                }
                            }
                        },
                        "dailyUniqueContract.detectMenuButton": {
                            //REDUCE ONNX OPTION
                            "recognition": {
                                "type": "ColorMatch",
                                "param": {
                                    "method": 40,
                                    "lower": [
                                        94,
                                        145,
                                        51
                                    ],
                                    "upper": [
                                        116,
                                        167,
                                        73
                                    ],
                                    "connected": true,
                                    "count": 1500,
                                    "order_by": "Vertical"
                                }
                            }
                        }
                    }
                },
                //----------------------------------ONNX----------------------------------
                {
                    "name": "preferONNX",
                    "label": "$pi.task.option.ONNX.preferONNX.name",
                    "description": "$pi.task.option.ONNX.preferONNX.description",
                    "pipeline_override": {
                        "actionRequiringSelect": {
                            //PREFER ONNX OPTION
                            "recognition": {
                                "type": "And",
                                "param": {
                                    "all_of": [
                                        "__cstCompareCrewUsed__",
                                        "__detectActionRequire__"
                                    ],
                                    "box_index": 1
                                }
                            }
                        },
                        "actionRequireAssignCrew": {
                            //PREFER ONNX OPTION
                            "recognition": {
                                "type": "And",
                                "param": {
                                    "all_of": [
                                        "__cstUpdateAssignCrewCard__",
                                        "__detectSlideBlock__"
                                    ],
                                    "box_index": 1
                                }
                            }
                        },
                        "ClickRampAgentSwitch": {
                            //PREFER ONNX OPTION
                            "recognition": {
                                "type": "Or",
                                "param": {
                                    "any_of": [
                                        "__detectSwitchOff__"
                                    ]
                                }
                            }
                        },
                        "actionRequireStandSelect": {
                            //PREFER ONNX OPTION
                            "recognition": {
                                "type": "And",
                                "param": {
                                    "all_of": [
                                        "__cstUpdateStandSelectCard__",
                                        "__detectStandSelectOption__"
                                    ],
                                    "box_index": 1
                                }
                            }
                        },
                        "actionRequiringSelectDeparture": {
                            //PREFER ONNX OPTION
                            "recognition": {
                                "type": "Or",
                                "param": {
                                    "any_of": [
                                        "__detectActionRequireExcludeAssignCrew__"
                                    ]
                                }
                            }
                        },
                        "dailyUniqueContract.detectMenuButton": {
                            //PREFER ONNX OPTION
                            "recognition": {
                                "type": "NeuralNetworkDetect",
                                "param": {
                                    "expected": "menuButton",
                                    "model": "MaaWoA-widget.onnx"
                                }
                            }
                        }
                    }
                }
            ],
            "default_case": "default"
        }
    }
}
