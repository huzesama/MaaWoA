{
    "option": {
        "ONNX": {
            "type": "select",
            //减少使用ONNX
            "label": "$pi.task.option.ONNX.name",
            "description": "$pi.task.option.ONNX.description",
            "cases": [
                {
                    "name": "default",
                    "label": "$pi.task.option.ONNX.default.name",
                    "description": "$pi.task.option.ONNX.default.description"
                },
                {
                    "name": "reduceONNX",
                    "label": "$pi.task.option.ONNX.reduceONNX.name",
                    "description": "$pi.task.option.ONNX.reduceONNX.description",
                    "pipeline_override": {
                        "actionRequiringSelect": {
                            //所有行動中隨機選擇action require的flight card//recognition由ONNX选项覆写
                            "recognition": {
                                "type": "Or",
                                "param": {
                                    "any_of": [
                                        "__detectActionRequire__"
                                    ]
                                }
                            }
                        },
                        "actionRequiringSelectDeparture": {
                            //选择departure//recognition由ONNX选项覆写
                            "recognition": {
                                "type": "And",
                                "param": {
                                    "all_of": [
                                        "__matchActionRequireList__",
                                        "__matchActionRequireExcludeAssignCrew__"
                                    ]
                                }
                            }
                        },
                        "dailyUniqueContract.detectMenuButton": {
                            //检测菜单按钮并点击//recognition由ONNX选项覆写
                            "recognition": {
                                "type": "ColorMatch",
                                "param": {
                                    "method": 40,
                                    "lower": [
                                        94,
                                        145,
                                        51
                                    ],
                                    "upper": [
                                        116,
                                        167,
                                        73
                                    ],
                                    "connected": true,
                                    "count": 1500,
                                    "order_by": "Vertical"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "preferONNX",
                    "label": "$pi.task.option.ONNX.preferONNX.name",
                    "description": "$pi.task.option.ONNX.preferONNX.description",
                    "pipeline_override": {
                        "actionRequiringSelect": {
                            //所有行動中隨機選擇action require的flight card//recognition由ONNX选项覆写
                            "recognition": {
                                "type": "Or",
                                "param": {
                                    "any_of": [
                                        "__detectActionRequireByONNX__"
                                    ]
                                }
                            }
                        },
                        "actionRequiringSelectDeparture": {
                            //选择departure//recognition由ONNX选项覆写
                            "recognition": {
                                "type": "Or",
                                "param": {
                                    "any_of": [
                                        "__matchActionRequireExcludeAssignCrewByONNX__"
                                    ]
                                }
                            }
                        },
                        "dailyUniqueContract.detectMenuButton": {
                            //检测菜单按钮并点击//recognition由ONNX选项覆写
                            "recognition": {
                                "type": "NeuralNetworkDetect",
                                "param": {
                                    "expected": "menuButton",
                                    "model": "WoA-widget.onnx"
                                }
                            }
                        }
                    }
                }
            ],
            "default_case": "default"
        }
    }
}
