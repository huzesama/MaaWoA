{
    "option": {
        "freezeCheck": {
            "controller": [
                "Adb"
            ],
            "label": "$pi.task.option.freezeCheck.name",
            "description": "$pi.task.option.freezeCheck.description",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "isFreezeOrNot": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "isFreezeOrNot": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "enabledTower": {
            //启用塔台
            "label": "$pi.task.option.enabledTower.name",
            "description": "$pi.task.option.enabledTower.description",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "extendTower": {
                            //主要更改enabled
                            "enabled": true
                        },
                        "detectFilterAirplaneOnAirportButton": {
                            //主要更改expected
                            "expected": "filterAirplaneOnAirport"
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        },
        "notSkipProcessUp": {
            //识别失败的页面不重启而是等待操作。
            "label": "$pi.task.option.notSkipProcessUp.name",
            "description": "$pi.task.option.notSkipProcessUp.description",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "unattendedMode": {
                            //主要更改next
                            "anchor": {
                                "afterStart": ""
                            },
                            "next": [
                                "detectPage"
                            ]
                        }
                    }
                }
            ]
        },
        "unknownPageWaitting": {
            //识别失败的页面不重启而是等待操作。
            "label": "$pi.task.option.unknownPageWaitting.name",
            "description": "$pi.task.option.unknownPageWaitting.description",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "detectPage": {
                            //检测当前所在页面
                            "next": [
                                "[JumpBack]detectEntryAirportPage", //进入机场页
                                "[JumpBack]detectAirportSelectPage", //机场选择页
                                "[JumpBack]detectHomePage", //主页
                                "[JumpBack]detectLoadingPage", //加载页面
                                "[JumpBack]detectErrorPage", //错误页面
                                "[JumpBack]finishWithDelay"
                            ]
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        },
        "randomSelectStand": {
            //随机选择降落航班的机位。
            "label": "$pi.task.option.randomSelectStand.name",
            "description": "$pi.task.option.randomSelectStand.description",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "__standSelectMatch__": {
                            "order_by": "Horizontal" //由base选项randomSelectStand覆写
                        }
                    }
                }
            ]
        },
        "bribery": {
            //行动请求事件处理超时贿赂选项开关
            "label": "$pi.task.option.bribery.name",
            "description": "$pi.task.option.bribery.description",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "universalAction_bribeFlight": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "universalAction_bribeFlight": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "enableTower": {
            //处理合同开启塔台选项
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No"
                }
            ]
        },
        "entryAirportIATA": {
